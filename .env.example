# --- Database -------------------------------------------------------------
# PostgreSQL connectiestring. Railway vult deze automatisch wanneer je een
# PostgreSQL-database aan je project koppelt.
DATABASE_URL=postgresql://gebruiker:wachtwoord@localhost:5432/carnegie_coach

# --- AI -------------------------------------------------------------------
# Welke aanbieder de coach gebruikt: "anthropic" of "openai".
# Je hoeft alleen de sleutel van de gekozen aanbieder in te vullen.
AI_PROVIDER=openai

# Sleutels blijven altijd server-side; ze worden nooit naar de browser gestuurd.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Server ---------------------------------------------------------------
PORT=3001
NODE_ENV=development
