# --- Database -------------------------------------------------------------
# PostgreSQL connectiestring. Railway vult deze automatisch wanneer je een
# PostgreSQL-database aan je project koppelt.
DATABASE_URL=postgresql://gebruiker:wachtwoord@localhost:5432/carnegie_coach

# --- AI -------------------------------------------------------------------
# Anthropic API-sleutel. Blijft altijd server-side; wordt nooit naar de
# browser gestuurd. Zonder deze sleutel start de server niet.
ANTHROPIC_API_KEY=

# Model dat de coach gebruikt.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Server ---------------------------------------------------------------
PORT=3001
NODE_ENV=development
