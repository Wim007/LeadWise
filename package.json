{
  "name": "carnegie-coach",
  "version": "1.0.0",
  "private": true,
  "description": "Persoonlijke AI-gedragstrainer voor betere gesprekken.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "npm --prefix server run db:migrate && npm --prefix server start",
    "db:migrate": "npm --prefix server run db:migrate",
    "lint": "npm --prefix client run lint",
    "postinstall": "npm --prefix server install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
